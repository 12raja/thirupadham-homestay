pipeline {
    agent any
    triggers { pollSCM('* * * * *') }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        IMAGE_NAME = "rajdpz/booking-service"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        stage('Build Docker Image') {
            when { changeset "booking-service/**" }
            steps { sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ./booking-service" }
        }
        stage('Push to Docker Hub') {
            when { changeset "booking-service/**" }
            steps {
                sh "echo ${DOCKERHUB_CREDENTIALS_PSW} | docker login -u ${DOCKERHUB_CREDENTIALS_USR} --password-stdin"
                sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
        stage('Deploy to Kubernetes') {
            when { changeset "booking-service/**" }
            steps {
                sh "kubectl set image deployment/booking-service booking-service=${IMAGE_NAME}:${IMAGE_TAG}"
                sh "kubectl rollout status deployment/booking-service"
            }
        }
    }
}
